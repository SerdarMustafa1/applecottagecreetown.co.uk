# Example environment variables for Apple Cottage Website
MEDIA_BASE_URL=https://d123.cloudfront.net
NETLIFY_BUILD_HOOK=https://api.netlify.com/build_hooks/abc123
# Public key used by the static map component
PUBLIC_GOOGLE_MAPS_API_KEY=your-maps-api-key-here
# Base URL for media served via CDN (S3/CloudFront)
# Example: https://d123.cloudfront.net
# Note: prefer MEDIA_BASE_URL over PUBLIC_ variant

# Before/After video URLs (optional)
# If you produce HLS with scripts/transcode_b4a.sh or MediaConvert, set the manifest URL:
PUBLIC_B4A_HLS=
# Progressive fallback sources:
PUBLIC_B4A_MP4_1080=
PUBLIC_B4A_MP4_2160=
PUBLIC_B4A_WEBM_1080=
# Poster image:
PUBLIC_B4A_POSTER=
