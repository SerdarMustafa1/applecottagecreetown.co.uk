{
  "name": "apple-cottage-site",
  "private": true,
  "version": "1.0.0",
  "description": "Static site for Apple Cottage with 360 video conversion at build time",
  "scripts": {
    "build": "node scripts/create_asset_placeholders.js && node scripts/convert_videos.js && node scripts/rewrite_media_base.js",
    "verify-cdn": "node scripts/verify_cdn.js",
    "verify-cdn:nowebm": "VERIFY_SKIP_WEBM=1 node scripts/verify_cdn.js",
    "ingest": "node scripts/ingest_media.js",
    "s3:inventory": "node scripts/inventory_and_diff.js",
    "s3:delete": "node scripts/delete_s3_keys.js",
    "assets:check-local": "node scripts/check_local_assets.js",
    "test:cdn": "node scripts/verify_cdn.js",
    "start:test": "http-server -p 8080 -c-1 .",
    "test:e2e": "playwright test",
    "test": "npm run test:cdn && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.0",
    "http-server": "^14.1.1"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "fluent-ffmpeg": "^2.1.2",
    "sharp": "^0.33.4"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
