{
  "name": "apple-cottage",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=18 <23"
  },
  "scripts": {
    "dev": "astro dev",
    "predev": "npm run generate:pwa-assets",
    "build": "astro build",
    "prebuild": "npm run generate:pwa-assets",
    "preview": "astro preview",
    "generate:pwa-assets": "node scripts/generate_pwa_assets.mjs",
    "check:cdn": "node scripts/check_cdn_urls.js",
    "check:variants": "node scripts/check_image_variants.js",
    "fix:cdn-images": "bash scripts/repair_cdn_images_from_s3.sh",
    "lint": "eslint src tests/unit",
    "test": "vitest run tests/unit",
    "pretest": "npm run generate:pwa-assets",
    "test:e2e": "playwright test tests/site-flows.e2e.spec.js",
    "test:lighthouse-hero": "playwright test tests/lighthouse-hero.e2e.spec.js",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "postinstall": "npm run generate:pwa-assets",
    "lighthouse": "lhci autorun --config=./lighthouse.config.js"
  },
  "dependencies": {
    "@astrojs/netlify": "^6.0.0",
    "@astrojs/react": "^3.0.0",
    "@astrojs/tailwind": "^6.0.2",
    "@vite-pwa/astro": "^1.1.0",
    "aframe": "^1.7.1",
    "astro": "^5.13.7",
    "lucide-react": "^0.453.0",
    "pannellum": "^2.5.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.8.3",
    "@eslint/js": "^9.34.0",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.46.0",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "@testing-library/dom": "^9.3.3",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^14.1.2",
    "@types/aframe": "^1.2.8",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/parser": "^8.43.0",
    "autoprefixer": "^10.4.14",
    "axe-core": "^4.8.3",
    "eslint": "^9.34.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "husky": "^9.1.6",
    "jsdom": "^26.1.0",
    "lighthouse-ci": "^1.13.1",
    "lint-staged": "^15.2.10",
    "playwright": "^1.46.0",
    "playwright-lighthouse": "^4.0.0",
    "png-to-ico": "^2.1.7",
    "postcss": "^8.4.31",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.0.0",
    "vitest": "^1.6.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.50.1"
  },
  "packageManager": "npm@11.4.2",
  "type": "module"
}
