---
import FloorplanViewerIsland from './FloorplanViewerIsland.tsx';
import site from '../../site.config';

const { floorplans = [], floorplans3d = [] } = site;

// Combine all plans into a single equal-sized grid
const allPlans = [
  ...floorplans,
  ...floorplans3d
];
---
<section id="floorplans" class="p-4 max-w-6xl mx-auto">
  <h2 class="text-3xl font-bold text-center mb-8">Floor Plans</h2>
  <FloorplanViewerIsland plans={allPlans} client:load />
</section>
