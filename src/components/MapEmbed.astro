---
import site from '../../site.config';
import * as locationMd from '../../content/location.md';

const { coordinates, address } = site;
const pois = (site as any).pois || [];
---
<section id="location" class="py-8">
  <div class="container">
    <h2 class="text-2xl font-bold mb-4">{locationMd?.frontmatter?.title || 'Location & Amenities'}</h2>
    <div class="grid gap-6 md:grid-cols-2">
      <div>
        <div id="leaflet-map" class="w-full h-64 md:h-80 border rounded overflow-hidden"></div>
        <p class="mt-2 text-center text-sm text-gray-600">Drag to move, scroll to zoom. Tap markers for details.</p>
        <div class="mt-3 flex justify-center">
          <a
            href="https://what3words.com/silk.dynamics.quitter"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 rounded-full border px-3 py-1 text-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500"
            aria-label="Open what3words location silk dot dynamics dot quitter in a new tab"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12.97 2.17c.3-.62 1.16-.62 1.46 0l1.82 3.77c.12.25.12.55 0 .8l-4.63 9.61a.83.83 0 0 1-1.5-.02L7.46 6.74a.9.9 0 0 1 0-.8l1.82-3.77c.3-.62 1.16-.62 1.46 0l.73 1.52.5-1.02Zm5.28 3.01c.3-.62 1.16-.62 1.46 0l1.82 3.77c.12.25.12.55 0 .8l-4.63 9.61a.83.83 0 0 1-1.5-.02l-2.66-5.59 3.51-7.28c.12-.25.12-.55 0-.8l.5-1.02Zm-10.56 0c.3-.62 1.16-.62 1.46 0l1.82 3.77c.12.25.12.55 0 .8L6.34 19.36a.83.83 0 0 1-1.5-.02L3.02 14.1l4.95-10.28c.12-.25.12-.55 0-.8l.5-1.02Z"/>
            </svg>
            <span>///silk.dynamics.quitter</span>
          </a>
        </div>
      </div>
      <div>
        <div class="prose mx-auto md:mx-0">
          {locationMd?.Content && <locationMd.Content />}
        </div>
        <div class="mt-4">
          <h3 class="text-lg font-semibold mb-2">Nearby Points of Interest</h3>
          <ul id="poi-list" class="space-y-2 text-sm">
            {pois.map((p, i) => (
              <li>
                <button
                  class="w-full text-left p-2 rounded border hover:bg-gray-50 disabled:opacity-60"
                  data-poi-index={i}
                  disabled={!Number.isFinite(p.lat) || !Number.isFinite(p.lng)}
                >
                  <span class="font-medium">{p.title}</span>
                  {p.subtitle && <span class="text-gray-600"> — {p.subtitle}</span>}
                  {p.meta && <div class="text-gray-500">{p.meta}</div>}
                </button>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Leaflet CSS/JS via CDN (light footprint, no API key) -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="anonymous" />
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" />
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" />
<script is:inline>
  {`(function(){
    // Load Leaflet and MarkerCluster in order, then init map
    function loadScript(src){
      return new Promise(function(resolve, reject){
        var s = document.createElement('script');
        s.src = src; s.async = true; s.onload = resolve; s.onerror = reject; document.head.appendChild(s);
      });
    }
    var center = [${coordinates.lat}, ${coordinates.lng}];
    var homePopup = ${JSON.stringify(address)};
    var pois = ${JSON.stringify(pois || [])};
    (async function(){
      try {
        await loadScript('https://unpkg.com/leaflet@1.9.4/dist/leaflet.js');
        await loadScript('https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js');
        var mapEl = document.getElementById('leaflet-map');
        if (!mapEl || typeof window.L === 'undefined') return;
        var L = window.L;
        var map = L.map(mapEl).setView(center, 14);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 19,
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        }).addTo(map);
        var cluster = L.markerClusterGroup();
        map.addLayer(cluster);
        var homeMarker = L.marker(center).bindPopup('<strong>Apple Cottage</strong><br/>' + homePopup);
        cluster.addLayer(homeMarker);
        var bounds = L.latLngBounds([center]);
        var poiMarkers = [];
        pois.forEach(function(p){
          if (typeof p.lat === 'number' && typeof p.lng === 'number') {
            var html = '<strong>' + (p.title || 'POI') + '</strong>' + (p.subtitle ? '<br/>' + p.subtitle : '') + (p.meta ? '<br/>' + p.meta : '');
            var m = L.marker([p.lat, p.lng]).bindPopup(html);
            poiMarkers.push(m);
            cluster.addLayer(m);
            bounds.extend([p.lat, p.lng]);
          } else {
            poiMarkers.push(null);
          }
        });
        if (bounds.isValid()) { map.fitBounds(bounds.pad(0.2)); }
        var list = document.getElementById('poi-list');
        if (list) {
          list.addEventListener('click', function(e){
            var btn = e.target.closest('button[data-poi-index]');
            if (!btn) return;
            var idx = parseInt(btn.getAttribute('data-poi-index'), 10);
            var marker = poiMarkers[idx];
            if (marker) {
              var latlng = marker.getLatLng();
              map.setView(latlng, 15, { animate: true });
              marker.openPopup();
            }
          }, { passive: true });
        }
      } catch(e) {
        console && console.warn && console.warn('Leaflet map init failed', e);
      }
    })();
  })();`}
  </script>
