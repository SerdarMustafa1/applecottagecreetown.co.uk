---
const { items = [] } = Astro.props;
---
<section id="highlights" class="py-8">
  <div class="container">
    <div class="grid gap-4 sm:grid-cols-2 md:grid-cols-4">
      {items.map((item) => (
        <div class="rounded border p-4" aria-label={item.label}>
          <h3 class="font-semibold">{item.label}</h3>
          <p>{item.value}</p>
        </div>
      ))}
    </div>
  </div>
</section>
