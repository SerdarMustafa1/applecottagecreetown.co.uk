---
import site from '../../site.config';
---
<section id="virtual-tours" class="py-16 bg-gray-50">
  <div class="container mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">360° Virtual Tours</h2>
      <p class="text-lg text-gray-600 max-w-3xl mx-auto">
        Experience every room in immersive 360° detail. Click on any tour below to explore the property as if you were walking through it yourself.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {site.virtual360Tours?.map((tour, index) => (
        <div key={index} class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow">
          <div class="relative group cursor-pointer" onclick={`openVirtualTour(${index})`}>
            <img 
              src={tour.poster} 
              alt={tour.label}
              class="w-full h-48 object-cover"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-black bg-opacity-40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
              <div class="text-white text-center">
                <svg class="w-16 h-16 mx-auto mb-2" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z"/>
                </svg>
                <p class="font-semibold">Start 360° Tour</p>
              </div>
            </div>
            <div class="absolute top-4 right-4 bg-blue-600 text-white px-3 py-1 rounded-full text-sm font-semibold">
              360°
            </div>
          </div>
          <div class="p-4">
            <h3 class="text-xl font-semibold text-gray-900 mb-2">{tour.label}</h3>
            <p class="text-gray-600 text-sm">{tour.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Virtual Tour Modal -->
  <div id="virtual-tour-modal" class="fixed inset-0 bg-black bg-opacity-90 flex items-center justify-center z-50 hidden">
    <div class="relative max-w-6xl max-h-[90vh] w-full mx-4">
      <button 
        onclick="closeVirtualTour()" 
        class="absolute -top-12 right-0 text-white hover:text-gray-300 transition-colors z-10"
        aria-label="Close virtual tour"
      >
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
      
      <video 
        id="virtual-tour-video"
        controls 
        class="w-full h-full rounded-lg"
        poster=""
        preload="metadata"
      >
        <source id="virtual-tour-mp4" src="" type="video/mp4">
        <source id="virtual-tour-webm" src="" type="video/webm">
        Your browser does not support the video tag.
      </video>
      
      <div class="absolute bottom-4 left-4 bg-black bg-opacity-70 text-white px-4 py-2 rounded-lg">
        <h4 id="virtual-tour-title" class="font-semibold"></h4>
        <p id="virtual-tour-description" class="text-sm opacity-90"></p>
      </div>
    </div>
  </div>
</section>

<script>
  const tours = window.site?.virtual360Tours || [];
  
  function openVirtualTour(index) {
    const tour = tours[index];
    if (!tour) return;
    
    const modal = document.getElementById('virtual-tour-modal');
    const video = document.getElementById('virtual-tour-video');
    const mp4Source = document.getElementById('virtual-tour-mp4');
    const webmSource = document.getElementById('virtual-tour-webm');
    const title = document.getElementById('virtual-tour-title');
    const description = document.getElementById('virtual-tour-description');
    
    // Set video sources
    mp4Source.src = tour.videoMp4;
    webmSource.src = tour.videoWebm;
    video.poster = tour.poster;
    
    // Set title and description
    title.textContent = tour.label;
    description.textContent = tour.description;
    
    // Load and show modal
    video.load();
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }
  
  function closeVirtualTour() {
    const modal = document.getElementById('virtual-tour-modal');
    const video = document.getElementById('virtual-tour-video');
    
    video.pause();
    modal.classList.add('hidden');
    document.body.style.overflow = 'auto';
  }
  
  // Close on escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeVirtualTour();
    }
  });
  
  // Close on backdrop click
  document.getElementById('virtual-tour-modal')?.addEventListener('click', (e) => {
    if (e.target === e.currentTarget) {
      closeVirtualTour();
    }
  });
  
  // Site configuration data is available via the global script tag below
</script>

<!-- Pass site config to client-side JavaScript -->
<script define:vars={{ siteConfig: site }}>
  // Make site config available globally
  if (typeof window !== 'undefined') {
    window.siteConfig = siteConfig;
  }
</script>

<style>
  #virtual-tour-modal video {
    max-height: 80vh;
  }
  
  @media (max-width: 768px) {
    #virtual-tour-modal video {
      max-height: 70vh;
    }
  }
</style>
