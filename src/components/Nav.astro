---
import site from '../../site.config';
---
<header class="sticky top-0 z-50 bg-white shadow">
  <div class="mx-auto max-w-7xl flex items-center justify-between p-4">
    <a href="/" id="nav-brand" class="text-xl font-bold">Apple Cottage</a>
    <button
      id="nav-toggle"
      type="button"
      class="p-2 border rounded md:hidden"
      aria-expanded="false"
      aria-controls="nav-menu"
    >
      <span class="sr-only">Toggle navigation</span>
      <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"
        ></path>
      </svg>
    </button>
    <ul
      id="nav-menu"
      class="hidden flex flex-col gap-2 bg-white md:bg-transparent md:static md:flex md:flex-row md:gap-4 md:border-0"
      aria-hidden="true"
    >
      <li><a href="#gallery" class="block px-4 py-2 hover:underline">Gallery</a></li>
      <li><a href="#highlights" class="block px-4 py-2 hover:underline">Highlights</a></li>
      <li><a href="#virtual-tours" class="block px-4 py-2 hover:underline">360° Tours</a></li>
      <li><a href="#floorplans" class="block px-4 py-2 hover:underline">Floor Plans</a></li>
      <li><a href="#location" class="block px-4 py-2 hover:underline">Location</a></li>
    </ul>
  </div>
</header>

<script is:inline>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');
  const brand = document.getElementById('nav-brand');

  const trackNavClick = (label, target) => {
    try {
      if (window.appleAnalytics && typeof window.appleAnalytics.trackNavigation === 'function') {
        window.appleAnalytics.trackNavigation({ label, target, location: 'header' });
      }
    } catch (error) {
      console.warn('Navigation analytics failed', error);
    }
  };

  if (brand) {
    brand.addEventListener('click', () => trackNavClick('Brand', '/'));
  }

  if (!toggle || !menu) {
    console.warn('Navigation toggle or menu not found.');
  } else {
    const setMenuExpanded = (expanded) => {
      toggle.setAttribute('aria-expanded', String(expanded));
      menu.setAttribute('aria-hidden', String(!expanded));
      menu.classList.toggle('hidden', !expanded);
    };

    setMenuExpanded(false);

    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      setMenuExpanded(!expanded);
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        trackNavClick(link.textContent?.trim() || 'nav-link', link.getAttribute('href') || '#');
        if (window.matchMedia('(max-width: 767px)').matches) {
          setMenuExpanded(false);
        }
      });
    });
  }
</script>
