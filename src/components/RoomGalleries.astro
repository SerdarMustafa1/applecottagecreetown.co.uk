---
import site from '../../site.config';

// Helper to pick images from the unified `site.images` by room tag
const pickByRoom = (roomTag: string) => ((site as any).images || []).filter((i: any) => Array.isArray(i.rooms) ? i.rooms.includes(roomTag) : false);

// Prefer explicit bedroom groups if provided in site.config.ts; otherwise derive
const explicitMaster = (site.roomGalleries as any)?.bedroomMaster || [];
const explicitBed2 = (site.roomGalleries as any)?.bedroom2 || [];
const explicitBed3 = (site.roomGalleries as any)?.bedroom3 || [];
const hasExplicitBedrooms = (explicitMaster.length + explicitBed2.length + explicitBed3.length) > 0;

const allBedrooms = hasExplicitBedrooms ? [] : (site.roomGalleries?.bedrooms || []).slice();
const isMaster = (img: any) => /master[-\s]?bedroom/i.test(img?.src || '') || /master/i.test(img?.alt || '');
const derivedMaster = hasExplicitBedrooms ? [] : allBedrooms.filter(isMaster);
const derivedOthers = hasExplicitBedrooms ? [] : allBedrooms.filter((img) => !isMaster(img));
const splitIndex = hasExplicitBedrooms ? 0 : Math.ceil(derivedOthers.length / 2);
const derivedBed2 = hasExplicitBedrooms ? [] : derivedOthers.slice(0, splitIndex);
const derivedBed3 = hasExplicitBedrooms ? [] : derivedOthers.slice(splitIndex);

const masterBedrooms = hasExplicitBedrooms ? explicitMaster : derivedMaster;
const bedroom2 = hasExplicitBedrooms ? explicitBed2 : derivedBed2;
const bedroom3 = hasExplicitBedrooms ? explicitBed3 : derivedBed3;

const roomData = [
  {
    title: 'Kitchen',
    description: 'Modern kitchen with quality appliances and ample storage space',
    images: pickByRoom('kitchen'),
    icon: '🍳'
  },
  {
    title: 'Living Areas', 
    description: 'Spacious and comfortable living spaces perfect for relaxation',
    images: pickByRoom('livingAreas'),
    icon: '🛋️'
  },
  {
    title: 'Bedrooms',
    description: 'Bright and airy bedrooms with fitted storage solutions', 
    images: pickByRoom('bedrooms'),
    icon: '🛏️',
    subrooms: [
      { title: 'Master Bedroom', images: pickByRoom('bedrooms').filter((i:any) => /master/i.test(i.alt || i.src || '')), icon: '👑' },
      { title: 'Bedroom 2', images: pickByRoom('bedrooms').slice(0, 2), icon: '2️⃣' },
      { title: 'Bedroom 3', images: pickByRoom('bedrooms').slice(2, 6), icon: '3️⃣' },
    ]
  },
  {
    title: 'Bathroom',
    description: 'Modern family bathroom with quality fittings',
    images: pickByRoom('bathroom'),
    icon: '🛁'
  }
];
---
<section id="room-galleries" class="py-16 bg-white">
  <div class="container mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Room by Room</h2>
      <p class="text-lg text-gray-600 max-w-3xl mx-auto">
        Explore every room in detail with our comprehensive photo galleries. Each space has been carefully photographed to showcase the quality and character of Apple Cottage.
      </p>
    </div>

    <div id="room-galleries-accordion" class="divide-y divide-gray-200 rounded-2xl border border-gray-200 bg-white">
      {roomData.map((room, index) => room.images.length > 0 && (
        <details class="group room-accordion" key={index} id={`rg-top-${index}`}>
          <summary class="flex items-center gap-4 w-full cursor-pointer list-none p-4 md:p-6 hover:bg-gray-50 focus:outline-none focus-visible:ring focus-visible:ring-blue-600/30">
            <div class="inline-flex items-center justify-center w-12 h-12 md:w-14 md:h-14 bg-blue-100 rounded-full">
              <span class="text-xl md:text-2xl" role="img" aria-label={room.title}>{room.icon}</span>
            </div>
            <div class="flex-1">
              <h3 class="text-xl md:text-2xl font-semibold text-gray-900">{room.title}</h3>
              <p class="text-gray-600 text-sm md:text-base">{room.description}</p>
            </div>
            <div class="ml-auto flex items-center gap-3">
              <a class="text-sm text-blue-600 hover:underline" href={`/#gallery?gallery=${String(room.title).toLowerCase().replace(/\s+/g,'')}&index=0`}>View in gallery</a>
              <svg class="h-5 w-5 text-gray-500 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 10.94l3.71-3.71a.75.75 0 111.06 1.06l-4.24 4.24a.75.75 0 01-1.06 0L5.21 8.29a.75.75 0 01.02-1.08z" clip-rule="evenodd" />
            </svg>
            </div>
          </summary>
          <div class="px-4 pb-6 md:px-6 md:pb-8">
            {room.title === 'Bedrooms' && room.subrooms ? (
              <div class="divide-y divide-gray-200 rounded-xl border border-gray-200 bg-white">
                <div class="flex items-center justify-end gap-2 p-3 md:p-4">
                  <button type="button" class="px-3 py-1.5 rounded border text-sm hover:bg-gray-50" data-action="expand-all-bedrooms">Expand all</button>
                  <button type="button" class="px-3 py-1.5 rounded border text-sm hover:bg-gray-50" data-action="collapse-all-bedrooms">Collapse all</button>
                </div>
                {room.subrooms.map((sr, sidx) => sr.images && sr.images.length > 0 && (
                  <details class="group rg-bedroom">
                    <summary class="flex items-center gap-3 w-full cursor-pointer list-none p-3 md:p-4 hover:bg-gray-50 focus:outline-none">
                      <div class="inline-flex items-center justify-center w-8 h-8 bg-blue-50 rounded-full">
                        <span class="text-base" role="img" aria-label={sr.title}>{sr.icon}</span>
                      </div>
                      <span class="font-medium text-gray-900">{sr.title}</span>
                      <svg class="ml-auto h-4 w-4 text-gray-500 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 10.94l3.71-3.71a.75.75 0 111.06 1.06l-4.24 4.24a.75.75 0 01-1.06 0L5.21 8.29a.75.75 0 01.02-1.08z" clip-rule="evenodd" />
                      </svg>
                    </summary>
                    <div class="px-3 pb-4 md:px-4 md:pb-6">
                      <div class="bg-gray-50 rounded-xl p-3 md:p-4">
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-2">
                          {sr.images.slice(0,4).map((img, idx) => (
                            <a href={`/#gallery?gallery=bedrooms&index=${idx}`} aria-label={`Open ${sr.title} image ${idx+1} in gallery`} class="block rounded overflow-hidden">
                              <img src={img.src} alt={img.alt || ''} class="w-full h-24 object-cover rounded" loading="lazy" />
                            </a>
                          ))}
                        </div>
                        <div class="mt-3 text-sm">
                          <a class="inline-block text-blue-600 hover:underline" href={`/#gallery?gallery=bedrooms&index=0`}>View in gallery</a>
                          <span class="ml-3 text-gray-600">{sr.images.length} photos</span>
                        </div>
                      </div>
                    </div>
                  </details>
                ))}
              </div>
            ) : (
              <div class="bg-gray-50 rounded-2xl p-4 md:p-6">
                <div class="grid grid-cols-2 md:grid-cols-4 gap-2">
                  {room.images.slice(0,8).map((img, idx) => (
                    <a href={`/#gallery?gallery=${String(room.title).toLowerCase().replace(/\s+/g,'')}&index=${idx}`} aria-label={`Open ${room.title} image ${idx+1} in gallery`} class="block rounded overflow-hidden">
                      <img src={img.src} alt={img.alt || ''} class="w-full h-28 object-cover rounded" loading="lazy" />
                    </a>
                  ))}
                </div>
                <div class="mt-3 text-sm">
                  <a class="inline-block text-blue-600 hover:underline" href={`/#gallery?gallery=${String(room.title).toLowerCase().replace(/\s+/g,'')}&index=0`}>View in gallery</a>
                  <span class="ml-3 text-gray-600">{room.images.length} photos</span>
                </div>
              </div>
            )}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  /* Hide default summary marker */
  details > summary::-webkit-details-marker { display: none; }
  details > summary::marker { content: ''; }
  /* Smooth open/close spacing */
  details[open] > summary { border-bottom: 1px solid #e5e7eb; }
</style>

<script>
  // Persist open/closed state for accordion items and add expand/collapse for bedrooms
  (function(){
    const KEY = 'roomGalleriesOpenState_v1';
    const root = document.getElementById('room-galleries-accordion');
    if (!root) return;

    function saveState(){
      const state = Array.from(root.querySelectorAll('details'))
        .map((d, i) => ({ i, id: d.id || '', open: d.open, cls: d.classList.contains('rg-bedroom') ? 'bed' : 'top' }));
      try { localStorage.setItem(KEY, JSON.stringify(state)); } catch(e) {}
    }
    function restoreState(){
      let state = null;
      try { state = JSON.parse(localStorage.getItem(KEY) || 'null'); } catch(e) {}
      if (!Array.isArray(state)) return;
      const details = Array.from(root.querySelectorAll('details'));
      state.forEach((s, idx) => {
        const d = details[idx];
        if (d) d.open = !!s.open;
      });
    }

    restoreState();
    root.addEventListener('toggle', (e) => {
      if ((e.target as HTMLElement).tagName?.toLowerCase() === 'details') {
        saveState();
      }
    }, true);

    // Bedrooms expand/collapse
    root.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement)?.closest('button[data-action]') as HTMLButtonElement | null;
      if (!btn) return;
      const action = btn.dataset.action;
      if (action === 'expand-all-bedrooms' || action === 'collapse-all-bedrooms') {
        const openVal = action === 'expand-all-bedrooms';
        root.querySelectorAll('details.rg-bedroom').forEach((d) => { (d as HTMLDetailsElement).open = openVal; });
        saveState();
      }
    });
  })();
</script>
