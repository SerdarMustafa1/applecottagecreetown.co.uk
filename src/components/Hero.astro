---
import site from '../../site.config';
const hero = site.hero || {};
const homeReport = (site.docs || []).find?.((d) => /home\s*report/i.test(d.label || ''));
---
<section id="hero" class="relative">
  {hero.image ? (
    hero.imageWebp ? (
      <picture>
        <source srcset={hero.imageWebp} type="image/webp" />
        <img src={hero.image} alt="Apple Cottage hero" class="w-full h-[45vh] md:h-[60vh] object-cover" />
      </picture>
    ) : (
      <img src={hero.image} alt="Apple Cottage hero" class="w-full h-[45vh] md:h-[60vh] object-cover" />
    )
  ) : (
    <div class="w-full h-[40vh] bg-gray-100" />
  )}
  <div class="absolute inset-0 bg-black/30" aria-hidden="true"></div>
  <div class="absolute inset-0 flex items-center justify-center">
    <div class="text-center text-white px-4">
      <h1 class="text-3xl md:text-4xl font-bold drop-shadow">{site.title}</h1>
      <p class="mt-2 text-lg drop-shadow">{hero.tagline || site.description}</p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a href={hero.bookUrl || '#contact'} class="inline-block bg-blue-600 text-white px-6 py-3 rounded focus:outline-none focus-visible:ring focus-visible:ring-white/80">
          {hero.ctaLabel || 'Book a Viewing'}
        </a>
        {homeReport?.href && (
          <a
            id="hero-home-report-link"
            href={homeReport.href}
            target="_blank"
            rel="noopener"
            class="inline-block bg-white/90 text-gray-900 px-4 py-2 rounded focus:outline-none focus-visible:ring hover:bg-white"
            aria-label="Open Home Report (PDF) in a new tab"
          >
            View Home Report (PDF)
          </a>
        )}
      </div>
      {(site.portals?.purplebricks || site.portals?.s1homes) && (
        <div class="mt-3 flex flex-wrap justify-center gap-2" aria-label="External property links">
          {site.portals?.purplebricks && (
            <a
              href={site.portals.purplebricks}
              target="_blank"
              rel="noopener"
              class="px-3 py-1 rounded-full bg-white/90 text-gray-800 hover:bg-white focus:outline-none focus-visible:ring"
            >
              View on Purplebricks
            </a>
          )}
          {site.portals?.s1homes && (
            <a
              href={site.portals.s1homes}
              target="_blank"
              rel="noopener"
              class="px-3 py-1 rounded-full bg-white/90 text-gray-800 hover:bg-white focus:outline-none focus-visible:ring"
            >
              View on s1homes
            </a>
          )}
        </div>
      )}
    </div>
  </div>
</section>

{homeReport?.href && (
  <script is:inline>
    {`(function(){
      var el = document.getElementById('hero-home-report-link');
      if (!el) return;
      el.addEventListener('click', function(){
        if (window.gtag) {
          window.gtag('event', 'home_report_open', {
            event_category: 'engagement',
            event_label: 'hero',
          });
        }
      });
    })();`}
  </script>
)}
