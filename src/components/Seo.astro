---
import site from '../../site.config';
const { title, description } = Astro.props;
const url = Astro.url?.href || site.siteUrl || '';
const image = site.ogImage || site.hero?.image || '/images/og-default.jpg';
---
<title>{title}</title>
<meta name="description" content={description} />
<meta property="og:site_name" content={site.title} />
<link rel="canonical" href={url} />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={image} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<script
  type="application/ld+json"
  set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'SingleFamilyResidence',
    name: site.title,
    description: site.description,
    url,
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Silver Street',
      addressLocality: 'Creetown',
      postalCode: 'DG8 7HU',
      addressRegion: 'Dumfries and Galloway',
      addressCountry: 'GB'
    },
    numberOfBedrooms: 3,
    floorSize: { '@type': 'QuantitativeValue', value: 147, unitCode: 'MTK' },
    amenityFeature: [
      { '@type':'LocationFeatureSpecification', name: 'Annex with WC', value: 'Yes' },
      { '@type':'LocationFeatureSpecification', name: 'EV charger', value: 'Yes' },
      { '@type':'LocationFeatureSpecification', name: 'Solar PV + battery', value: 'Yes' }
    ],
    offers: { '@type': 'Offer', price: 250000, priceCurrency: 'GBP' }
  })}
/> 
