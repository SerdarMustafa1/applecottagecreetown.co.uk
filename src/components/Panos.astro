---
import Simple360Viewer from './Simple360Viewer.tsx';
import site from '../../site.config';
const panos = site.panos || [];
---
{panos.length > 0 && (
  <section id="panos" class="py-8">
    <div class="container">
      <h2 class="text-2xl font-semibold mb-2 text-center">Interactive 360° Photos</h2>
      <p class="text-center text-sm text-gray-600 mb-4">Drag to look around; use fullscreen for the best view.</p>
      <div class="max-w-5xl mx-auto grid gap-6 md:grid-cols-2">
        {panos.map((p) => (
          <Simple360Viewer client:load pano={p} />
        ))}
      </div>
    </div>
  </section>
)}
