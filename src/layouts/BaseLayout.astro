---
import '../styles/globals.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TrustBar from '../components/TrustBar.astro';
import StickyCTA from '../components/StickyCTA.astro';
import site from '../../site.config.ts';
import InstallPromptIsland from '../components/a2hs/InstallPromptIsland';

const { title = site.title, description = site.description } = Astro.props;
const gaId = site.analyticsId;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo {title} {description} />
    <meta name="application-name" content="Apple Cottage, Creetown" />
    <meta name="theme-color" content="#1f6c84" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Apple Cottage" />
    <meta name="format-detection" content="telephone=no" />
    <script is:inline define:vars={{ gaId }}>
        // Define GA id early on window to avoid ReferenceError from third‑party scripts
        (function(){ try { window.gaId = gaId || ''; } catch(e) {} })();
      </script>
      <link rel="stylesheet" id="silktide-consent-manager-css" href="/cookie-banner/silktide-consent-manager.css" />
      <script src="/cookie-banner/silktide-consent-manager.js" defer></script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="256x256" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/icons/pwa-icon.svg" color="#1f6c84" />
    <link rel="manifest" href="/site.webmanifest" />
    {site.hero?.image && <link rel="preload" as="image" href={site.hero.image} />}
      {gaId && (
        <script is:inline>
          (function(){
            var GA_ID = 'G-LHB9R5TLL1';
            var KEY = 'silktideCookieBanner_InitialChoice';
            var loaded = false;
            function loadGA(){
              if(loaded || !GA_ID) return; 
              loaded = true;
              window.dataLayer = window.dataLayer || [];
              function gtag(){ dataLayer.push(arguments); }
              window.gtag = gtag;
              try {
                var s = document.createElement('script');
                s.async = true;
                s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
                s.onerror = function() { console.log('GA blocked by ad blocker'); };
                document.head.appendChild(s);
                gtag('js', new Date());
                gtag('config', GA_ID);
              } catch(e) {
                console.log('GA initialization failed:', e);
              }
            }
            try {
              var choice = localStorage.getItem(KEY);
              if (choice === '1') { loadGA(); }
            } catch(e) {}
            document.addEventListener('cookie-consent-accepted', loadGA, { once: true });
          })();
        </script>
      )}
  </head>
  <body class="min-h-screen antialiased flex flex-col">
    <Header />
    <main class="flex-1">
      <!-- Hero slot: pages can provide a hero section via this named slot -->
      <slot name="hero" />
      <!-- Trust bar immediately under hero to surface EPC, HR and planning -->
      <TrustBar />
      <slot />
      <!-- Booking embed (TidyCal) sits above the footer as primary booking option -->
      <section id="book-viewing" style="padding:1.5rem 0">
        <div class="tidycal-embed" data-path="sidmustafa/apple-cottage-viewing"></div>
        <script src="https://asset-tidycal.b-cdn.net/js/embed.js" async></script>
        <p style="margin-top:0.5rem;color:#6b7280">If the booking widget does not load, <a href={site.bookingUrl} target="_blank" rel="noopener">open booking in a new tab</a>.</p>
          <script is:inline>
            (function(){
              // Track tidycal embed interactions for analytics (resilient when GA not yet loaded)
              function sendEvent(action, label){
                try{
                  if (window.gtag) {
                    window.gtag('event', action, { event_label: label || 'tidycal', event_category: 'engagement' });
                  } else if (window.dataLayer) {
                    window.dataLayer.push({ event: action, label: label || 'tidycal' });
                  }
                } catch(e) { /* ignore */ }
              }

              // Mark when the tidycal container gains an iframe -> embed ready
              var tidyContainer = document.querySelector('.tidycal-embed');
              if (tidyContainer) {
                // If an iframe is already present, assume loaded
                var existing = tidyContainer.querySelector('iframe');
                if (existing) {
                  sendEvent('tidycal_loaded', location.pathname + location.search);
                } else {
                  // Observe for children added (iframe insertion by tidycal script)
                  try {
                    var mo = new MutationObserver(function(m){
                      m.forEach(function(rec){
                        rec.addedNodes && rec.addedNodes.forEach(function(n){
                          if (n.nodeName === 'IFRAME' || (n.querySelector && n.querySelector('iframe'))) {
                            sendEvent('tidycal_loaded', location.pathname + location.search);
                            mo.disconnect();
                          }
                        });
                      });
                    });
                    mo.observe(tidyContainer, { childList: true, subtree: true });
                  } catch(e) { /* MutationObserver not supported */ }
                }
              }

              // Track fallback link clicks
              var fallback = document.querySelector('#tidycal-fallback-link');
              if (!fallback) {
                // add id to existing fallback link
                var fb = document.querySelector('#book-viewing a[rel~="noopener"]');
                if (fb) {
                  fb.id = 'tidycal-fallback-link';
                  fb.addEventListener('click', function(){ sendEvent('tidycal_fallback_click', fb.href); });
                }
              } else {
                fallback.addEventListener('click', function(){ sendEvent('tidycal_fallback_click', fallback.href); });
              }
            })();
          </script>
      </section>
    </main>
    <Footer />
    <!-- Sticky CTA persists on screen for quick booking / report download -->
    <StickyCTA />
    <InstallPromptIsland client:load />
    <script type="module">
      import '../pwa.ts';
    </script>
  </body>
</html>
