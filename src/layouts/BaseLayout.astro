---
import '../styles/globals.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TrustBar from '../components/TrustBar.astro';
import StickyCTA from '../components/StickyCTA.astro';
import site from '../../site.config.ts';
import InstallPromptIsland from '../components/a2hs/InstallPromptIsland';

const { title = site.title, description = site.description } = Astro.props;
const gaId = site.analyticsId;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo {title} {description} />
    <meta name="application-name" content="Apple Cottage, Creetown" />
    <meta name="theme-color" content="#1f6c84" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Apple Cottage" />
    <meta name="format-detection" content="telephone=no" />
    <script is:inline define:vars={{ gaId }}>
        // Define GA id early on window to avoid ReferenceError from third‑party scripts
        (function(){ try { window.gaId = gaId || ''; } catch(e) {} })();
      </script>
      <link rel="stylesheet" id="silktide-consent-manager-css" href="/cookie-banner/silktide-consent-manager.css" />
      <script src="/cookie-banner/silktide-consent-manager.js" defer></script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="256x256" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/icons/pwa-icon.svg" color="#1f6c84" />
    <link rel="manifest" href="/site.webmanifest" />
    <script is:inline>
      {(function () {
        return `(() => {
          const queueKey = '__appleAnalyticsQueue';
          const win = window;
          if (!Array.isArray(win[queueKey])) {
            win[queueKey] = [];
          }
          if (!Array.isArray(win.dataLayer)) {
            win.dataLayer = [];
          }
          const queue = win[queueKey];

          const compact = (obj) => {
            const result = {};
            if (!obj || typeof obj !== 'object') return result;
            Object.keys(obj).forEach((key) => {
              const value = obj[key];
              if (value !== undefined && value !== null && value !== '') {
                result[key] = value;
              }
            });
            return result;
          };

          const pushToDataLayer = (eventName, params) => {
            try {
              win.dataLayer.push(Object.assign({ event: eventName }, params || {}));
            } catch (error) {
              console.warn('dataLayer push failed', error);
            }
          };

          const sendWithGtag = (eventName, params) => {
            if (typeof win.gtag === 'function') {
              try {
                win.gtag('event', eventName, params || {});
              } catch (error) {
                console.error('gtag dispatch failed', error);
              }
              return true;
            }
            return false;
          };

          const trackEvent = (eventName, params) => {
            if (!eventName) return;
            const payload = compact(params || {});
            pushToDataLayer(eventName, payload);
            if (!sendWithGtag(eventName, payload)) {
              queue.push({ name: eventName, params: payload });
            }
          };

          const flushQueue = () => {
            if (typeof win.gtag !== 'function') return;
            if (!Array.isArray(queue) || queue.length === 0) return;
            while (queue.length) {
              const entry = queue.shift();
              if (entry && entry.name) {
                try {
                  win.gtag('event', entry.name, entry.params || {});
                } catch (error) {
                  console.error('Queued analytics flush failed', error);
                }
              }
            }
          };

          const api = Object.assign({}, win.appleAnalytics || {}, {
            trackEvent,
            flushQueue,
            trackCta(details = {}) {
              trackEvent('cta_click', compact({
                cta_name: details.name,
                cta_location: details.location,
                destination_url: details.destination,
                cta_type: details.type,
                cta_variant: details.variant,
                cta_format: details.format,
              }));
            },
            trackDocument(details = {}) {
              trackEvent('document_open', compact({
                document_name: details.name,
                document_url: details.url,
                document_location: details.location,
                document_format: details.format,
              }));
            },
            trackMedia(details = {}) {
              trackEvent('media_engagement', compact({
                media_type: details.mediaType,
                media_action: details.action,
                media_label: details.label,
                media_identifier: details.identifier,
                media_index: details.index,
                media_total: details.total,
                media_filter: details.filter,
                media_direction: details.direction,
                media_location: details.location,
                engagement_seconds: details.seconds,
              }));
            },
            trackNavigation(details = {}) {
              trackEvent('navigation_click', compact({
                nav_label: details.label,
                nav_target: details.target,
                nav_location: details.location,
              }));
            },
            trackContact(details = {}) {
              trackEvent('contact_action', compact({
                contact_method: details.method,
                contact_location: details.location,
                contact_destination: details.destination,
              }));
            },
            trackGalleryFilter(details = {}) {
              trackEvent('gallery_filter', compact({
                gallery_filter: details.filter,
                gallery_count: details.total,
              }));
            },
            trackBookingInterest(details = {}) {
              trackEvent('booking_interest', compact({
                booking_source: details.source || 'unknown',
              }));
            }
          });

          win.appleAnalytics = api;

          win.addEventListener('applecottage:booking-interest', (event) => {
            const source = event?.detail?.source || 'unknown';
            api.trackBookingInterest({ source });
          }, { passive: true });

          win.addEventListener('applecottage:gallery-viewed', (event) => {
            const detail = event?.detail || {};
            api.trackEvent('gallery_view', compact({
              media_type: 'gallery',
              image_src: detail.src || detail.id,
              image_alt: detail.alt,
              image_index: typeof detail.index === 'number' ? detail.index : undefined,
              gallery_total: detail.total,
              gallery_filter: detail.filter,
            }));
          }, { passive: true });

          win.addEventListener('applecottage:tour-watch', (event) => {
            const detail = event?.detail || {};
            const seconds = Number(detail.secondsWatched ?? detail.seconds ?? detail.delta ?? 0);
            api.trackEvent('media_engagement', compact({
              media_type: detail.source === 'video' ? 'virtual_tour' : 'pano',
              media_action: 'progress',
              media_label: detail.label,
              media_identifier: detail.tourId || detail.panoSrc || detail.src,
              engagement_seconds: seconds > 0 ? seconds : undefined,
            }));
          }, { passive: true });

          win.addEventListener('applecottage:offline-download', () => {
            api.trackEvent('offline_download', { engagement_location: 'pwa' });
          }, { passive: true });
        })();`;
      })()}
    </script>
    {site.hero?.image && <link rel="preload" as="image" href={site.hero.image} />}
      {gaId && (
        <script is:inline>
          (function(){
            var GA_ID = 'G-LHB9R5TLL1';
            var KEY = 'silktideCookieBanner_InitialChoice';
            var loaded = false;
            function loadGA(){
              if(loaded || !GA_ID) return; 
              loaded = true;
              window.dataLayer = window.dataLayer || [];
              function gtag(){ dataLayer.push(arguments); }
              window.gtag = gtag;
              try {
                var s = document.createElement('script');
                s.async = true;
                s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
                s.onerror = function() { console.log('GA blocked by ad blocker'); };
                document.head.appendChild(s);
                gtag('js', new Date());
                gtag('config', GA_ID);
                try {
                  if (window.appleAnalytics && typeof window.appleAnalytics.flushQueue === 'function') {
                    window.appleAnalytics.flushQueue();
                  }
                } catch (flushError) {
                  console.warn('Unable to flush queued analytics events', flushError);
                }
              } catch(e) {
                console.log('GA initialization failed:', e);
              }
            }
            try {
              var choice = localStorage.getItem(KEY);
              if (choice === '1') { loadGA(); }
            } catch(e) {}
            document.addEventListener('cookie-consent-accepted', loadGA, { once: true });
          })();
        </script>
      )}
  </head>
  <body class="min-h-screen antialiased flex flex-col">
    <Header />
    <main class="flex-1">
      <!-- Hero slot: pages can provide a hero section via this named slot -->
      <slot name="hero" />
      <!-- Trust bar immediately under hero to surface EPC, HR and planning -->
      <TrustBar />
      <slot />
      <!-- Booking redirect -->
      <section id="book-viewing" style="padding:1.5rem 0; text-align:center">
        <div style="max-width:600px; margin:0 auto; padding:2rem; background:#f8fafc; border-radius:12px; border:1px solid #e2e8f0">
          <h2 style="margin:0 0 1rem; font-size:1.5rem; font-weight:600; color:#1e293b">Book a Viewing</h2>
          <p style="margin:0 0 1.5rem; color:#64748b">Schedule a viewing directly using the booking link below.</p>
          <a href={site.bookingUrl} target="_blank" rel="noopener" style="display:inline-block; background:#059669; color:white; padding:0.75rem 2rem; border-radius:8px; text-decoration:none; font-weight:600">Book a viewing</a>
        </div>
      </section>
      <script is:inline>
        {`(function(){
          var cta = document.querySelector('#book-viewing a[href]');
          if (!cta) return;
          cta.addEventListener('click', function(){
            var href = cta.getAttribute('href');
            try {
              if (window.appleAnalytics && typeof window.appleAnalytics.trackCta === 'function') {
                window.appleAnalytics.trackCta({
                  name: 'Book Viewing External',
                  location: 'book-viewing-section',
                  destination: href,
                  type: 'external',
                  variant: 'book-viewing'
                });
              }
            } catch (ctaError) {
              console.warn('Book viewing CTA tracking failed', ctaError);
            }
            try {
              if (window.appleAnalytics && typeof window.appleAnalytics.trackContact === 'function') {
                window.appleAnalytics.trackContact({
                  method: 'external_booking',
                  location: 'book-viewing-section',
                  destination: href
                });
              }
            } catch (contactError) {
              console.warn('Book viewing contact tracking failed', contactError);
            }
            try {
              window.dispatchEvent(new CustomEvent('applecottage:booking-interest', { detail: { source: 'book_viewing_section' } }));
            } catch (eventError) {
              console.warn('Unable to dispatch booking interest from section', eventError);
            }
          });
        })();`}
      </script>
    </main>
    <Footer />
    <!-- Sticky CTA persists on screen for quick booking / report download -->
    <StickyCTA />
    <InstallPromptIsland client:load />
    <script type="module">
      import '../pwa.ts';
    </script>
  </body>
</html>
