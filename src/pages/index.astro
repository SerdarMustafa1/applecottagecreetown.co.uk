---
import BaseLayout from '../layouts/BaseLayout.astro';
import * as homeMd from '../../content/home.md';
import * as highlightsMd from '../../content/highlights.md';
import * as faqMd from '../../content/faq.md';
import Hero from '../components/Hero.astro';
import HighlightCards from '../components/HighlightCards.astro';
import PropertyDetails from '../components/PropertyDetails.astro';
import ContactFormIsland from '../components/ContactFormIsland.tsx';
import FAQ from '../components/FAQ.astro';
import MapEmbed from '../components/MapEmbed.astro';
import DocumentList from '../components/DocumentList.astro';
import Floorplans from '../components/Floorplans.astro';
import Gallery from '../components/Gallery.astro';
import Panos from '../components/Panos.astro';
import site from '../../site.config';
const pageTitle = homeMd?.frontmatter?.title ?? site.title;
const pageDescription = homeMd?.frontmatter?.description ?? site.description;
const coreHighlights = [
  { label: 'Guide Price', value: site.price },
  { label: 'Bedrooms', value: String(site.bedrooms) },
  { label: 'Bathrooms', value: String(site.bathrooms) },
  { label: 'EPC Rating', value: site.epc }
];
const extraHighlights = highlightsMd?.frontmatter?.items || [];
const highlightItems = [...coreHighlights, ...extraHighlights];
---
<BaseLayout title={pageTitle} description={pageDescription}>
  <Hero />
  <section class="prose mx-auto p-4">
    {homeMd?.Content && <homeMd.Content />}
  </section>
  <Gallery />
  <HighlightCards items={highlightItems} />
  <PropertyDetails />
  <Panos />
  <Floorplans />
  <MapEmbed />
  <section id="contact" class="p-4 max-w-lg mx-auto">
    <h2 class="text-2xl font-semibold mb-4">Book a Viewing</h2>
    <ContactFormIsland client:load />
  </section>
  <FAQ items={faqMd?.frontmatter?.questions || []} />
  <DocumentList docs={site.docs} />
</BaseLayout>
