.env
# Local 360 sources and generated outputs
360-source/
dist/

# macOS
.DS_Store
 
# Astro/Dev caches and editor files
.astro/
.tmp/
.vscode/

# Local 360 posters/videos if temporarily present under assets
assets/images/interior/*-360-poster.jpg
assets/videos/interior/*-360.mp4
.DS_Store
assets/.DS_Store
assets/images/.DS_Store
assets/videos/.DS_Store
assets/videos/interior/.DS_Store
node_modules/
# Allow committing lock file for reproducible installs
!package-lock.json

# Ignore heavy public media; use CDN via PUBLIC_MEDIA_BASE_URL
public/images/**/*.jpg
public/images/**/*.jpeg
public/images/**/*.png
public/images/**/*.webp
public/images/**/*.avif
public/panos/**
public/floorplans/**/*.jpg
public/floorplans/**/*.jpeg
public/floorplans/**/*.png
public/docs/**/*.pdf
!public/**/*.svg
!public/**/.gitkeep

# Generated PWA icon assets (created via scripts/generate_pwa_assets.mjs)
public/apple-touch-icon.png
public/favicon.png
public/favicon.ico
public/icons/icon-*.png
public/icons/maskable-icon-*.png

assets/images/
assets/videos/

# Large floor plan and model assets (served from CDN)
# Note: Placeholder files under 1KB are committed for CI/CD
assets/floorplans/
assets/models/

# Large 3D model files (served from CDN)
assets/models-local/*.usdz
assets/models-local/*.glb

# Terraform local state (do not commit)
infra/.terraform/
infra/terraform.tfstate
infra/terraform.tfstate.backup
*.tfstate
*.tfstate.backup
crash.log
*.tfstate.backup
crash.log
test-results/
# Playwright artifacts produced during E2E runs
artifacts/
playwright-report/
.http-server.pid

# Local Netlify folder
.netlify
